<section class="section">
  <div class="section-head">
    <h2>Reservas</h2>
  </div>

  {{#if bookings}}
    <div class="bookings">
      {{#each bookings}}
        <article class="booking-card {{#if (eq status 'confirmada')}}is-confirmed{{else if (eq status 'cancelada')}}is-cancelled{{else}}is-pending{{/if}}">
          <div class="booking-card__top">
            <span class="booking-date">{{date}}</span>
            {{#if (eq status 'confirmada')}}
              <span class="badge badge--ok">Confirmada</span>
            {{else if (eq status 'cancelada')}}
              <span class="badge badge--off">Cancelada</span>
            {{else}}
              <span class="badge badge--pending">{{capitalize status}}</span>
            {{/if}}
          </div>
          <h3>{{clientName}}</h3>
          <p class="booking-email">{{clientEmail}}</p>
          <dl class="booking-meta">
            <div>
              <dt>Hora</dt>
              <dd>{{time}}</dd>
            </div>
            <div>
              <dt>Servicios</dt>
              <dd>{{services.length}}</dd>
            </div>
          </dl>

          {{#if services.length}}
            <ul class="booking-services">
              {{#each services}}
                <li>
                  <span>{{#if service}}{{service.name}}{{else}}Servicio eliminado{{/if}}</span>
                  <span class="booking-qty">×{{quantity}}</span>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="booking-empty">Sin servicios asignados.</p>
          {{/if}}
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="empty-state">No hay reservas registradas.</p>
  {{/if}}

  {{#if pagination.totalPages}}
    <nav class="pagination" aria-label="Paginación de reservas">
      {{#if pagination.hasPrevPage}}
        <a class="pagination__link" href="{{pagination.prevLink}}" rel="prev">← Anterior</a>
      {{else}}
        <span class="pagination__link is-disabled" aria-disabled="true">← Anterior</span>
      {{/if}}

      <span class="pagination__info">
        Página <strong>{{pagination.page}}</strong> de <strong>{{pagination.totalPages}}</strong>
        · {{pagination.totalDocs}} reservas
      </span>

      {{#if pagination.hasNextPage}}
        <a class="pagination__link" href="{{pagination.nextLink}}" rel="next">Siguiente →</a>
      {{else}}
        <span class="pagination__link is-disabled" aria-disabled="true">Siguiente →</span>
      {{/if}}
    </nav>
  {{/if}}
</section>

<section class="section">
  <div class="section-head">
    <h2>En vivo (Socket.IO)</h2>
    <span class="live-dot" aria-hidden="true"></span>
  </div>

  <div id="bookings-live" class="live-panel live-panel--bookings" aria-live="polite"></div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/socket.js"></script>

