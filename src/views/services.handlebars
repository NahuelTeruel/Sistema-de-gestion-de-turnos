<section class="section">
  <div class="section-head">
    <h2>Servicios disponibles</h2>
  </div>

  {{#if services}}
    <div class="services">
      {{#each services}}
        <article class="service-card {{#unless available}}is-unavailable{{/unless}}">
          <div class="service-card__top">
            <span class="service-category">{{category}}</span>
            {{#if available}}
              <span class="badge badge--ok">Disponible</span>
            {{else}}
              <span class="badge badge--off">No disponible</span>
            {{/if}}
          </div>
          <h3>{{name}}</h3>
          <p class="service-description">{{description}}</p>
          <dl class="service-meta">
            <div>
              <dt>Precio</dt>
              <dd class="service-price">${{price}}</dd>
            </div>
            <div>
              <dt>Duración</dt>
              <dd>{{duration}} min</dd>
            </div>
          </dl>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="empty-state">No hay servicios disponibles.</p>
  {{/if}}

  {{#if pagination.totalPages}}
    <nav class="pagination" aria-label="Paginación de servicios">
      {{#if pagination.hasPrevPage}}
        <a class="pagination__link" href="{{pagination.prevLink}}" rel="prev">← Anterior</a>
      {{else}}
        <span class="pagination__link is-disabled" aria-disabled="true">← Anterior</span>
      {{/if}}

      <span class="pagination__info">
        Página <strong>{{pagination.page}}</strong> de <strong>{{pagination.totalPages}}</strong>
        · {{pagination.totalDocs}} servicios
      </span>

      {{#if pagination.hasNextPage}}
        <a class="pagination__link" href="{{pagination.nextLink}}" rel="next">Siguiente →</a>
      {{else}}
        <span class="pagination__link is-disabled" aria-disabled="true">Siguiente →</span>
      {{/if}}
    </nav>
  {{/if}}
</section>

<section class="section">
  <div class="section-head">
    <h2>En vivo (Socket.IO)</h2>
    <span class="live-dot" aria-hidden="true"></span>
  </div>

  <div id="services-live" class="live-panel" aria-live="polite"></div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/socket.js"></script>

